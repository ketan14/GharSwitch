{
  "name": "ghar-switch-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "backend/firebase/functions",
    "packages/*",
    "tools"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:hosting": "npm run build -w web-portal",
    "build:functions": "npm run build -w functions",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build:hosting && firebase deploy --only hosting",
    "deploy:functions": "npm run build:functions && firebase deploy --only functions"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  }
}