{
    "name": "functions",
    "version": "1.0.0",
    "main": "lib/index.js",
    "dependencies": {
        "cors": "^2.8.5",
        "firebase-admin": "latest",
        "firebase-functions": "latest"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "typescript": "^5.0.0",
        "esbuild": "^0.20.0"
    },
    "engines": {
        "node": "22"
    },
    "scripts": {
        "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=lib/index.js --external:firebase-admin --external:firebase-functions --tsconfig=tsconfig.json",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "deploy": "firebase deploy --only functions"
    }
}